# ReadyLayer Environment Variables
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control

# ==============================================================================
# DATABASE (Required)
# ==============================================================================
# PostgreSQL connection string
# Required for all database operations
DATABASE_URL="postgresql://user:password@localhost:5432/readylayer"

# ==============================================================================
# AUTHENTICATION (Required)
# ==============================================================================
# Supabase configuration
# Required for user authentication and session management
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# ==============================================================================
# LLM PROVIDERS (At least one required at runtime)
# ==============================================================================
# OpenAI API key for GPT models
OPENAI_API_KEY="sk-your-openai-api-key"

# Anthropic API key for Claude models (alternative to OpenAI)
# ANTHROPIC_API_KEY="sk-ant-your-anthropic-api-key"

# Default LLM provider (optional, defaults to 'openai')
# DEFAULT_LLM_PROVIDER="openai"

# ==============================================================================
# ENCRYPTION (Required in production)
# ==============================================================================
# Master encryption key for encrypting sensitive data at rest
# Generate with: openssl rand -base64 32
# Required in production, optional in development
READY_LAYER_MASTER_KEY="your-base64-encoded-32-byte-key"

# Alternative encryption keys (optional, for key rotation)
# READY_LAYER_KMS_KEY=""
# READY_LAYER_KEYS=""
# ENCRYPTION_KEY=""

# ==============================================================================
# GITHUB INTEGRATION (Optional)
# ==============================================================================
# GitHub App configuration
# Required for GitHub repository integrations
# GITHUB_APP_ID="123456"
# GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# GITHUB_WEBHOOK_SECRET="your-webhook-secret"

# ==============================================================================
# STRIPE BILLING (Optional)
# ==============================================================================
# Stripe API keys
# Required for billing and subscription management
# STRIPE_SECRET_KEY="sk_test_your-stripe-secret-key"
# STRIPE_WEBHOOK_SECRET="whsec_your-stripe-webhook-secret"

# Stripe price IDs for subscription plans
# STRIPE_PRICE_ID_GROWTH="price_xxx"
# STRIPE_PRICE_ID_SCALE="price_xxx"

# ==============================================================================
# REDIS (Optional, recommended for production)
# ==============================================================================
# Redis connection URL
# Used for background job queues, caching, and rate limiting
# Falls back to database-based queue if not set
# REDIS_URL="redis://localhost:6379"

# ==============================================================================
# APPLICATION SETTINGS (Optional)
# ==============================================================================
# Node environment (development, production, test)
NODE_ENV="development"

# Application base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Log level (debug, info, warn, error)
# LOG_LEVEL="info"

# API base URL for internal API calls
# API_BASE_URL="http://localhost:3000"

# Database connection pool size
# Defaults to 5 in development, 20 in production
# DATABASE_POOL_SIZE="5"

# ==============================================================================
# FEATURES (Optional)
# ==============================================================================
# Enable RAG (Retrieval-Augmented Generation) for evidence layer
# RAG_ENABLED="false"

# ==============================================================================
# EXPERIMENTAL FEATURE FLAGS (Optional)
# ==============================================================================
# These features are experimental and may change or be removed.
# Only enable in production after thorough testing.

# AI Risk Index - Experimental AI-generated code risk scoring
# NEXT_PUBLIC_ENABLE_AI_RISK_INDEX="0"

# Bundle Execution - Execute evidence bundles via JobForge (requires scale tier)
# NEXT_PUBLIC_ENABLE_BUNDLE_EXECUTION="0"

# RAG Context - Retrieval-augmented generation for reviews
# NEXT_PUBLIC_ENABLE_RAG_CONTEXT="0"

# TruthCore Integration - Immutable audit trail (planned Q2 2026)
# NEXT_PUBLIC_ENABLE_TRUTHCORE="0"

# Advanced Reporting - Custom analytics and reports
# NEXT_PUBLIC_ENABLE_ADVANCED_REPORTING="0"

# Multi-Provider Analysis - Analyze code across multiple AI providers
# NEXT_PUBLIC_ENABLE_MULTI_PROVIDER="0"

# ==============================================================================
# VISUAL ASSETS (Optional)
# ==============================================================================
# Enable hero section illustration on landing page
# NEXT_PUBLIC_ENABLE_HERO_IMAGE="true"

# Enable value driver illustrations in feature cards
# NEXT_PUBLIC_ENABLE_VALUE_ILLUSTRATIONS="true"

# Enable empty state illustrations (replaces icons)
# NEXT_PUBLIC_ENABLE_EMPTY_STATE_IMAGES="true"

# Enable error state illustrations (replaces icons)
# NEXT_PUBLIC_ENABLE_ERROR_STATE_IMAGES="true"

# Strict asset validation in CI (fails build if assets missing)
# ASSET_STRICT="1"

# ==============================================================================
# DEVELOPMENT (Optional)
# ==============================================================================
# Skip environment variable validation at build time
# Useful for CI/CD pipelines
# NEXT_PUBLIC_SKIP_ENV_VALIDATION="true"

# Enable bundle analysis
# ANALYZE="true"

# Google Search Console verification code
# GOOGLE_VERIFICATION="your-google-verification-code"

# ==============================================================================
# DEMO MODE (Optional)
# ==============================================================================
# Enable deterministic demo mode endpoints and sandbox runs
# DEMO_MODE_ENABLED="true"
# DEMO_SANDBOX_ID="sandbox_sandbox_demo_abc123def456"
# DEMO_RUN_ID="demo_sandbox_demo_abc123def456"
