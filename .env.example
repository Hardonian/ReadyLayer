# Database Configuration
# ============================================================================
# IMPORTANT: For production, use Supabase Pooler to prevent connection exhaustion
#
# LOCAL DEVELOPMENT:
DATABASE_URL="postgresql://user:password@localhost:5432/readylayer?schema=public"
#
# PRODUCTION (Supabase Pooler - RECOMMENDED):
# Use pooler port 6543 for connection pooling via PgBouncer
# DATABASE_URL="postgresql://user:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=10&pool_timeout=10&statement_timeout=30000&lock_timeout=5000"
# DIRECT_URL="postgresql://user:password@aws-0-us-east-1.pooler.supabase.com:5432/postgres"
#
# Connection string parameters explained:
# - pgbouncer=true: Use PgBouncer pooling mode
# - connection_limit=10: Max connections per Prisma instance (prevents storms)
# - pool_timeout=10: Max 10s wait for connection from pool
# - statement_timeout=30000: Max 30s per query (prevents hung connections)
# - lock_timeout=5000: Max 5s wait for row locks
#
# DIRECT_URL is required for migrations (direct DB access, not pooled)
# ============================================================================

# Supabase (for authentication)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Redis (required for queue system)
REDIS_URL="redis://localhost:6379"

# LLM Providers (at least one required)
OPENAI_API_KEY="your-openai-api-key"
ANTHROPIC_API_KEY="your-anthropic-api-key"
DEFAULT_LLM_PROVIDER="openai"

# GitHub App (for integration)
GITHUB_APP_ID="your-github-app-id"
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nyour-github-app-private-key\n-----END RSA PRIVATE KEY-----"
GITHUB_WEBHOOK_SECRET="your-github-webhook-secret"

# App Configuration
NODE_ENV="development"
LOG_LEVEL="info"

# Database Performance Monitoring (Postgres Scaling)
# Enable slow query logging (queries > 1s logged automatically)
LOG_SLOW_QUERIES="false" # Set to "true" in production for performance monitoring

# API Configuration
API_BASE_URL="http://localhost:3000"
API_VERSION="v1"

# RAG Configuration (Evidence RAG Layer - defaults to disabled)
# Enable RAG features (requires Supabase migration with pgvector extension)
RAG_ENABLED=false
RAG_INGEST_ENABLED=false
RAG_QUERY_ENABLED=false
RAG_PROVIDER="disabled"
RAG_EMBED_MODEL="text-embedding-3-small"
RAG_MAX_CHUNKS_PER_DOC=100
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200
RAG_MAX_CONTEXT_TOKENS=4000

# Stripe Configuration (for billing)
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key"
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_secret"
STRIPE_PRICE_ID_GROWTH="price_your_growth_price_id"
STRIPE_PRICE_ID_SCALE="price_your_scale_price_id"

# Encryption Keys (required for production - at least one)
# Generate with: openssl rand -base64 32
READY_LAYER_MASTER_KEY="your-base64-encoded-32-byte-key"
# Or use KMS: READY_LAYER_KMS_KEY="your-kms-key-id"
# Or provide multiple keys for rotation: READY_LAYER_KEYS="key1,key2,key3"
