{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://readylayer.dev/contracts/findings.schema.json",
  "title": "ReadyLayer Normalized Findings",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "findings"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "tool": { "type": ["string", "null"] },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rule_id", "severity", "category", "message"],
        "properties": {
          "rule_id": { "type": "string" },
          "severity": { "type": "string" },
          "category": { "type": "string" },
          "message": { "type": "string" },
          "file": { "type": ["string", "null"] },
          "line": { "type": ["integer", "null"], "minimum": 1 }
        }
      }
    }
  }
}
