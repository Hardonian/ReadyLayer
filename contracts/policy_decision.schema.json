{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://readylayer.dev/contracts/policy_decision.schema.json",
  "title": "ReadyLayer Policy Decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_version",
    "decision",
    "reasons",
    "required_actions",
    "deterministic_statement"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "policy_version": { "type": "string" },
    "decision": {
      "type": "string",
      "enum": ["allow", "warn", "block"]
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rule_id", "message"],
        "properties": {
          "rule_id": { "type": "string" },
          "message": { "type": "string" }
        }
      }
    },
    "required_actions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "evidence_hashes": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "deterministic_statement": { "type": "string" }
  }
}
