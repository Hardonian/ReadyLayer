# Production Environment Variables Template for Vercel
# Copy this to Vercel Environment Variables in Project Settings

# ================================
# Database (Supabase/PostgreSQL)
# ================================
DATABASE_URL="postgresql://user:password@host:5432/readylayer"
DIRECT_URL="postgresql://user:password@host:5432/readylayer"

# ================================
# Authentication (Supabase)
# ================================
NEXT_PUBLIC_SUPABASE_URL="https://xxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJxxx..."
SUPABASE_SERVICE_ROLE_KEY="eyJxxx..."

# ================================
# GitHub Integration
# ================================
GITHUB_CLIENT_ID="Iv1.xxx"
GITHUB_CLIENT_SECRET="xxx"
GITHUB_APP_ID="123456"
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nxxx\n-----END RSA PRIVATE KEY-----"
GITHUB_WEBHOOK_SECRET="xxx"

# ================================
# Stripe (Billing)
# ================================
STRIPE_SECRET_KEY="sk_live_xxx"
STRIPE_PUBLISHABLE_KEY="pk_live_xxx"
STRIPE_WEBHOOK_SECRET="whsec_xxx"

# ================================
# LLM Providers
# ================================
OPENAI_API_KEY="sk-xxx"
ANTHROPIC_API_KEY="sk-ant-xxx"
OPENROUTER_API_KEY="sk-or-xxx"

# ================================
# Redis (Background Jobs)
# ================================
REDIS_URL="redis://default:password@redis.upstash.io:6379"

# ================================
# Encryption & Security
# ================================
ENCRYPTION_KEY="base64-encoded-32-byte-key"
NEXTAUTH_SECRET="random-secret-string"

# ================================
# Application
# ================================
NEXT_PUBLIC_APP_URL="https://readylayer.com"
NODE_ENV="production"
LOG_LEVEL="info"

# ================================
# Rate Limiting
# ================================
RATE_LIMIT_REQUESTS="100"
RATE_LIMIT_WINDOW_MS="60000"

# ================================
# Monitoring (Optional)
# ================================
SENTRY_DSN=""
DATADOG_API_KEY=""

# ================================
# Feature Flags (Optional)
# ================================
FEATURE_FLAG_AI_OPTIMIZATION="true"
FEATURE_FLAG_ADVANCED_ANALYTICS="true"
