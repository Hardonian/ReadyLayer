{
  "name": "readylayer",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run lint && npm run type-check && next build",
    "analyze": "ANALYZE=true npm run build",
    "start": "next start",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "postinstall": "prisma generate",
    "prepare": "husky install || true",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:validate": "prisma validate",
    "worker:webhook": "tsx workers/webhook-processor.ts",
    "worker:job": "tsx workers/job-processor.ts",
    "migrate:run": "tsx scripts/run-migration-prisma.ts",
    "migrate:verify": "tsx scripts/verify-migration.ts",
    "db:inventory-live": "tsx scripts/db-inventory-live.ts",
    "db:inventory-expected": "tsx scripts/db-inventory-expected.ts",
    "db:verify": "tsx scripts/db-verify.ts",
    "db:smoke": "tsx scripts/db-smoke.ts",
    "db:reconcile": "psql \"$DATABASE_URL\" -f supabase/migrations/00000000000000_backend_contract_reconcile.sql",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:tenant-isolation": "tsx scripts/test-tenant-isolation.ts",
    "test:billing": "tsx scripts/test-billing-enforcement.ts",
    "middleware:smoke": "tsx scripts/middleware-smoke.ts",
    "secrets:encrypt-tokens": "tsx scripts/encrypt-existing-tokens.ts",
    "secrets:migrate-tokens": "tsx scripts/migrate-installation-tokens.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:golden-path": "tsx scripts/test-golden-path.ts",
    "doctor": "tsx scripts/doctor.ts",
    "clean": "rm -rf .next node_modules/.cache dist",
    "verify": "npm run lint && npm run type-check && npm test"
  },
  "overrides": {
    "glob": "^10.5.0"
  },
  "dependencies": {
    "@babel/parser": "^7.28.6",
    "@babel/types": "^7.28.6",
    "@octokit/app": "^16.1.2",
    "@octokit/rest": "^22.0.1",
    "@radix-ui/react-avatar": "^1.0.4",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-dropdown-menu": "^2.0.6",
    "@radix-ui/react-progress": "^1.0.3",
    "@radix-ui/react-select": "^2.0.0",
    "@radix-ui/react-slot": "^1.0.2",
    "@radix-ui/react-tabs": "^1.0.4",
    "@radix-ui/react-toast": "^1.1.5",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.90.1",
    "@tanstack/react-query": "^5.90.19",
    "@tanstack/react-query-devtools": "^5.91.2",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "commander": "^14.0.2",
    "framer-motion": "^12.26.2",
    "js-yaml": "^4.1.0",
    "lucide-react": "^0.562.0",
    "next": "^16.1.3",
    "next-themes": "^0.4.6",
    "pino": "^10.2.0",
    "pino-pretty": "^13.1.3",
    "rate-limiter-flexible": "^9.0.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "recharts": "^3.6.0",
    "redis": "^5.10.0",
    "stripe": "^20.2.0",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.3.5",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@next/eslint-plugin-next": "^16.1.3",
    "@playwright/test": "^1.57.0",
    "@prisma/client": "^5.22.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.10.6",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.53.0",
    "@typescript-eslint/parser": "^8.53.0",
    "autoprefixer": "^10.4.16",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.1.3",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.0.0",
    "playwright": "^1.57.0",
    "postcss": "^8.4.33",
    "prisma": "^5.22.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^4.0.17"
  },
  "engines": {
    "node": "20.x"
  }
}
