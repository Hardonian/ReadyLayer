  prNumber          Int?
  prSha             String?
  correlationId     String?
  source            String
  sourceSystem      String
  agent             Json
  redactionLevel    String   @default("safe")
  payloadEncrypted  Boolean  @default(false)
  payload           Json
  payloadHash       String
  promptHashes      Json?
  toolCallSummary   Json?
  safeSummary       Json?
  createdAt         DateTime @default(now())

