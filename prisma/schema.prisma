  allowAggregation Boolean @default(true)
  aggregationWindow Int   @default(30) // Days
  provenanceRetentionDays Int @default(180)
  provenanceMaxPayloadKB Int @default(512)
  provenanceRedactionDefault String @default("safe")
  provenanceAllowRawStorage Boolean @default(false)
  provenanceEnabled Boolean @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}



model ProvenancePack {
