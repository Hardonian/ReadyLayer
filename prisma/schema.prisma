  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, modelId, provider])
  @@index([organizationId])
  @@index([modelId])
  @@index([provider])
  @@index([lastUpdated])
}

// Aggregated Insights (patterns, anomalies, optimizations)
