  firstSeen       DateTime
  lastSeen        DateTime
  trend           String   // increasing, decreasing, stable
  metadata        Json?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([insightType])
  @@index([confidence])
  @@index([lastSeen])
}

// Data Retention Policy (compliance configuration)
