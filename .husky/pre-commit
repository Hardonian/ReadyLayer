#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# Pre-commit hook: Run lint, type-check, and tests before committing

echo "🔍 Running pre-commit checks..."

# Run linter
echo "📝 Linting..."
npm run lint || { echo "❌ Lint failed. Fix errors before committing."; exit 1; }

# Run type checker
echo "🔧 Type checking..."
npm run type-check || { echo "❌ Type check failed. Fix type errors before committing."; exit 1; }

# Run tests (quick unit tests only, skip E2E)
echo "🧪 Running tests..."
npm test || { echo "❌ Tests failed. Fix failing tests before committing."; exit 1; }

echo "✅ All pre-commit checks passed!"
